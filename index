   ══════════════════════════════════ */
function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(function() { t.classList.remove('show'); }, 2800);
}

/* ══════════════════════════════════
   SHARE — opens native sheet:
   WhatsApp, Messenger, iMessage…
   ══════════════════════════════════ */
async function shareVerse() {
  const v    = VERSES[todayIdx];
  const text = '\u201C' + v.en + '\u201D\n\n'
             + v.ar + '\n\n'
             + '\u2014 ' + v.ref + '\n\n'
             + '\u2726 Wise for Salvation \u00B7 St. George Brooklyn Retreat 2026';

  let file = null;
  try {
    const cv   = await buildCanvas();
    const blob = await new Promise(function(res) { cv.toBlob(res, 'image/png', 1.0); });
    file = new File([blob], 'daily-verse.png', {type:'image/png'});
  } catch(e) { /* image generation optional */ }

  /* Share image + text via native sheet (WhatsApp, Messenger, iMessage, etc.) */
  if (file && navigator.share && navigator.canShare && navigator.canShare({files:[file]})) {
    try { await navigator.share({files:[file], title:'Daily Verse \u2014 ' + v.ref, text:text}); return; }
    catch(e) { if (e.name === 'AbortError') return; }
  }
  /* Share text only via native sheet */
  if (navigator.share) {
    try { await navigator.share({title:'Daily Verse \u2014 ' + v.ref, text:text}); return; }
    catch(e) { if (e.name === 'AbortError') return; }
  }
  /* Clipboard fallback */
  try { await navigator.clipboard.writeText(text); showToast('\u2726 Verse copied to clipboard'); }
  catch(e) { showToast('Copy the verse text manually'); }
}

/* ══════════════════════════════════
   SAVE IMAGE TO GALLERY
   ══════════════════════════════════ */
async function downloadVerse() {
  try {
    const cv   = await buildCanvas();
    const blob = await new Promise(function(res) { cv.toBlob(res, 'image/png', 1.0); });
    const name = 'daily-verse-' + VERSES[todayIdx].ref.replace(/[\s:]/g,'-') + '.png';
    const file = new File([blob], name, {type:'image/png'});

    /* iOS / Android: share sheet → "Save to Photos" */
    if (navigator.share && navigator.canShare && navigator.canShare({files:[file]})) {
      await navigator.share({files:[file], title:'Save Verse Image'}); return;
    }
    /* Desktop: direct download */
    const url = URL.createObjectURL(blob);
    const a   = document.createElement('a');
    a.href = url; a.download = name;
    document.body.appendChild(a); a.click(); document.body.removeChild(a);
    setTimeout(function() { URL.revokeObjectURL(url); }, 5000);
    showToast('\u2713 Image downloaded');
  } catch(e) {
    if (e && e.name !== 'AbortError') showToast('Try taking a screenshot instead');
  }
}

/* ══════════════════════════════════
   INIT
   ══════════════════════════════════ */
render();
