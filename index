/* ══════════════════════════════════
   NY TIMEZONE HELPERS
   ══════════════════════════════════ */
function getNYDateObj() {
  const nyStr = new Intl.DateTimeFormat('en-US', {
    timeZone: 'America/New_York',
    year:'numeric', month:'2-digit', day:'2-digit'
  }).format(new Date());
  const [m, d, y] = nyStr.split('/').map(Number);
  return new Date(y, m - 1, d);
}

function getNYDayOfYear() {
  const nyDate  = getNYDateObj();
  const start   = new Date(nyDate.getFullYear(), 0, 1);
  return Math.floor((nyDate - start) / 86400000) + 1;
}

function getNYDisplayDate() {
  return new Intl.DateTimeFormat('en-US', {
    timeZone: 'America/New_York',
    weekday:'long', month:'long', day:'numeric', year:'numeric'
  }).format(new Date());
}

/* ══════════════════════════════════
   STATE
   ══════════════════════════════════ */
const todayIdx = (getNYDayOfYear() - 1) % VERSES.length;

function render() {
  const v = VERSES[todayIdx];
  document.getElementById('verseEn').textContent  = '\u201C' + v.en + '\u201D';
  document.getElementById('verseAr').textContent  = v.ar;
  document.getElementById('verseRef').textContent = v.ref;
  document.getElementById('dateText').textContent = getNYDisplayDate();
}

/* ══════════════════════════════════
   CANVAS IMAGE GENERATOR
   ══════════════════════════════════ */
function wrapLines(ctx, text, maxW) {
  const words = text.split(' ');
  const lines = [];
  let   line  = '';
  words.forEach(function(w) {
    const test = line ? line + ' ' + w : w;
    if (ctx.measureText(test).width > maxW && line) {
      lines.push(line);
      line = w;
    } else {
      line = test;
    }
  });
  if (line) lines.push(line);
  return lines;
}

async function buildCanvas() {
  await document.fonts.ready;
  const S   = 1080;
  const PAD = 76;
  const CW  = S - PAD * 2;
  const CX  = S / 2;

  const cv  = document.createElement('canvas');
  cv.width  = S;
  cv.height = S;
  const c   = cv.getContext('2d');

  /* Background gradient */
  const bg = c.createLinearGradient(0, 0, 0, S);
  bg.addColorStop(0,   '#0A1530');
  bg.addColorStop(0.5, '#0D1E45');
  bg.addColorStop(1,   '#080F20');
  c.fillStyle = bg;
  c.fillRect(0, 0, S, S);

  /* Cross-grid watermark */
  c.strokeStyle = 'rgba(212,160,23,0.09)';
  c.lineWidth   = 0.6;
  for (let x = 0; x <= S; x += 70) { c.beginPath(); c.moveTo(x,0); c.lineTo(x,S); c.stroke(); }
  for (let y = 0; y <= S; y += 70) { c.beginPath(); c.moveTo(0,y); c.lineTo(S,y); c.stroke(); }

  /* Radial gold glow */
  const glow = c.createRadialGradient(CX, 200, 0, CX, 200, 500);
  glow.addColorStop(0,   'rgba(212,160,23,0.12)');
  glow.addColorStop(1,   'rgba(212,160,23,0)');
  c.fillStyle = glow;
  c.fillRect(0, 0, S, S);

  /* Gold top bar */
  c.fillStyle = '#D4A017';
  c.fillRect(0, 0, S, 5);

  /* Gold bottom bar */
  c.fillRect(0, S-5, S, 5);

  /* Church name */
  c.fillStyle   = '#D4A017';
  c.font        = '500 26px "Cinzel", Georgia, serif';
  c.textAlign   = 'center';
  c.textBaseline= 'top';
  c.fillText('ST. GEORGE COPTIC ORTHODOX CHURCH · BROOKLYN', CX, 30);

  /* Cross symbol */
  c.fillStyle = '#D4A017';
  c.font      = '80px serif';
  c.fillText('\u2769', CX, 72);

  /* Retreat label */
  c.fillStyle = 'rgba(212,160,23,0.65)';
  c.font      = '400 22px "Cinzel", Georgia, serif';
  c.fillText('✦  WISE FOR SALVATION  ·  RETREAT 2026  ✦', CX, 168);

  /* Date */
  c.fillStyle = '#080F20';
  c.fillRect(CX - 210, 203, 420, 38);
  const dateGrad = c.createLinearGradient(CX-210,0,CX+210,0);
  dateGrad.addColorStop(0, 'transparent');
  dateGrad.addColorStop(0.1, '#D4A017');
  dateGrad.addColorStop(0.9, '#D4A017');
  dateGrad.addColorStop(1, 'transparent');
  c.fillStyle   = dateGrad;
  c.fillRect(CX-210, 203, 420, 38);
  c.fillStyle   = '#080F20';
  c.font        = '600 20px "Cinzel", Georgia, serif';
  c.fillText(getNYDisplayDate().toUpperCase(), CX, 211);

  /* Divider */
  const ruleY = 256;
  c.strokeStyle = 'rgba(212,160,23,0.3)';
  c.lineWidth   = 1;
  c.beginPath(); c.moveTo(PAD, ruleY); c.lineTo(S-PAD, ruleY); c.stroke();

  /* English verse */
  const v = VERSES[todayIdx];
  c.fillStyle   = 'rgba(251,247,238,0.95)';
  c.font        = 'italic 38px "Crimson Pro", "Georgia", serif';
  c.textAlign   = 'center';
  const enText  = '\u201C' + v.en + '\u201D';
  const enLines = wrapLines(c, enText, CW);
  const enLH    = 56;
  let   y       = 282;
  enLines.forEach(function(l) { c.fillText(l, CX, y); y += enLH; });

  /* Arabic verse */
  c.save();
  c.direction   = 'rtl';
  c.textAlign   = 'center';
  c.fillStyle   = 'rgba(248,240,220,0.78)';
  c.font        = '44px "Amiri", "Arial Unicode MS", serif';
  const arLines = wrapLines(c, v.ar, CW);
  const arLH    = 64;
  y += 14;
  arLines.forEach(function(l) { c.fillText(l, CX, y); y += arLH; });
  c.restore();

  /* Reference */
  y += 10;
  c.fillStyle = '#D4A017';
  c.font      = '600 28px "Cinzel", Georgia, serif';
  c.textAlign = 'center';
  c.fillText(v.ref, CX, y);

  /* Bottom rule */
  y += 48;
  c.strokeStyle = 'rgba(212,160,23,0.25)';
  c.lineWidth   = 1;
  c.beginPath(); c.moveTo(PAD, y); c.lineTo(S-PAD, y); c.stroke();

  /* Bottom label */
  c.fillStyle = 'rgba(212,160,23,0.5)';
  c.font      = '400 20px "Cinzel", Georgia, serif';
  c.fillText('\u2769  DAILY VERSE  \u00B7  ST. GEORGE BROOKLYN  \u2769', CX, y + 16);

  return cv;
}

