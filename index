<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#080F20">
<title>Daily Verse · Wise for Salvation · Retreat 2026</title>
<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Crimson+Pro:ital,wght@0,300;0,400;0,600;1,400&family=Amiri:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
<style>
:root {
  --navy:   #080F20;
  --blue:   #0D2554;
  --blue2:  #1A3A80;
  --gold:   #D4A017;
  --goldt:  #F0C040;
  --cream:  #FBF7EE;
  --cream2: #C8BFA8;
  --muted:  #7A90B8;
  --white:  #FFFFFF;
}
* { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
html, body { height:100%; }
body {
  min-height:100vh;
  background:var(--navy);
  display:flex;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  font-family:'Crimson Pro',serif;
  color:var(--cream);
  padding:16px;
  position:relative;
  overflow-x:hidden;
}
body::before {
  content:'';
  position:fixed;
  inset:0;
  background-image:url("data:image/svg+xml,%3Csvg width='70' height='70' xmlns='http://www.w3.org/2000/svg'%3E%3Cg stroke='%23D4A017' stroke-width='.4' opacity='.09' fill='none'%3E%3Cline x1='35' y1='8' x2='35' y2='62'/%3E%3Cline x1='8' y1='26' x2='62' y2='26'/%3E%3C/g%3E%3C/svg%3E");
  background-size:70px 70px;
  pointer-events:none;
  z-index:0;
}
body::after {
  content:'';
  position:fixed;
  top:-220px; left:50%;
  transform:translateX(-50%);
  width:700px; height:500px;
  background:radial-gradient(ellipse, rgba(212,160,23,.1) 0%, transparent 70%);
  pointer-events:none;
  z-index:0;
}

/* ── CARD ── */
.card {
  position:relative;
  z-index:1;
  width:100%;
  max-width:720px;
  background:rgba(13,37,84,.5);
  border:1px solid rgba(212,160,23,.25);
  border-radius:22px;
  padding:44px 48px 38px;
  backdrop-filter:blur(14px);
  box-shadow:0 24px 80px rgba(0,0,0,.5);
  text-align:center;
}
.card::before {
  content:'';
  position:absolute;
  top:0; left:12%; right:12%;
  height:3px;
  background:linear-gradient(90deg,transparent,var(--gold),transparent);
  border-radius:2px;
}

/* ── HEADER ── */
.church-lbl {
  font-family:'Cinzel',serif;
  font-size:.6rem;
  letter-spacing:.28em;
  text-transform:uppercase;
  color:var(--gold);
  margin-bottom:4px;
}
.retreat-lbl {
  font-family:'Cinzel',serif;
  font-size:.55rem;
  letter-spacing:.2em;
  text-transform:uppercase;
  color:var(--muted);
  margin-bottom:14px;
}
.cross-sym {
  font-size:2.4rem;
  color:var(--gold);
  line-height:1;
  display:block;
  margin-bottom:4px;
  animation:glow 4s ease-in-out infinite;
}
@keyframes glow {
  0%,100%{opacity:1; text-shadow:0 0 12px rgba(212,160,23,.3)}
  50%     {opacity:.7; text-shadow:0 0 24px rgba(212,160,23,.6)}
}

/* ── DATE BADGE ── */
.date-badge {
  display:inline-flex;
  align-items:center;
  gap:6px;
  font-family:'Cinzel',serif;
  font-size:.65rem;
  letter-spacing:.16em;
  text-transform:uppercase;
  color:var(--navy);
  background:var(--gold);
  padding:.3rem 1.1rem;
  border-radius:30px;
  margin:12px 0 28px;
  font-weight:600;
}

/* ── RULE ── */
.rule {
  display:flex;
  align-items:center;
  gap:12px;
  margin:18px 0;
}
.rule::before, .rule::after {
  content:'';
  flex:1;
  height:1px;
  background:linear-gradient(90deg,transparent,rgba(212,160,23,.35),transparent);
}
.rule span { color:var(--gold); font-size:.9rem; opacity:.65; }

/* ── VERSE TEXT ── */
.verse-en {
  font-size:clamp(1.25rem,3vw,1.65rem);
  line-height:1.8;
  color:var(--cream);
  font-style:italic;
  letter-spacing:.01em;
}
.verse-ar {
  font-family:'Amiri',serif;
  font-size:clamp(1.15rem,2.8vw,1.5rem);
  line-height:2.1;
  color:rgba(248,240,220,.8);
  direction:rtl;
  text-align:right;
  margin-top:10px;
}
.reference {
  font-family:'Cinzel',serif;
  font-size:.78rem;
  letter-spacing:.18em;
  text-transform:uppercase;
  color:var(--gold);
  margin-top:16px;
  font-weight:600;
}
.today-tag {
  font-family:'Cinzel',serif;
  font-size:.55rem;
  letter-spacing:.14em;
  text-transform:uppercase;
  color:var(--goldt);
  margin-top:4px;
  opacity:.75;
  min-height:1em;
}



/* ── ACTION BUTTONS ── */
.action-row {
  display:flex;
  gap:10px;
  margin-top:28px;
  justify-content:center;
  flex-wrap:wrap;
}
.act-btn {
  display:flex;
  align-items:center;
  gap:7px;
  font-family:'Cinzel',serif;
  font-size:.62rem;
  letter-spacing:.14em;
  text-transform:uppercase;
  font-weight:600;
  padding:.6rem 1.3rem;
  border-radius:30px;
  border:none;
  cursor:pointer;
  transition:all .2s;
  flex:1;
  min-width:130px;
  max-width:180px;
  justify-content:center;
}
.act-btn:active { transform:scale(.94); }
.btn-share {
  background:var(--gold);
  color:var(--navy);
}
.btn-share:hover { background:var(--goldt); box-shadow:0 4px 18px rgba(212,160,23,.35); }
.btn-save {
  background:rgba(212,160,23,.12);
  color:var(--gold);
  border:1px solid rgba(212,160,23,.35);
}
.btn-save:hover { background:rgba(212,160,23,.22); }

/* ── TOAST ── */
.toast {
  position:fixed;
  bottom:28px;
  left:50%;
  transform:translateX(-50%) translateY(80px);
  background:rgba(13,37,84,.95);
  border:1px solid rgba(212,160,23,.35);
  color:var(--cream);
  font-family:'Cinzel',serif;
  font-size:.65rem;
  letter-spacing:.14em;
  text-transform:uppercase;
  padding:.65rem 1.5rem;
  border-radius:30px;
  backdrop-filter:blur(10px);
  z-index:1000;
  transition:transform .35s cubic-bezier(.34,1.56,.64,1);
  white-space:nowrap;
}
.toast.show { transform:translateX(-50%) translateY(0); }

/* ── FOOTER ── */
.footer {
  position:relative;
  z-index:1;
  margin-top:18px;
  text-align:center;
}
.footer p {
  font-family:'Cinzel',serif;
  font-size:.55rem;
  letter-spacing:.16em;
  text-transform:uppercase;
  color:rgba(120,140,180,.45);
}

/* ── FADE ── */
.fade-in { animation:fadeIn .45s ease; }
@keyframes fadeIn {
  from { opacity:0; transform:translateY(10px); }
  to   { opacity:1; transform:translateY(0); }
}

@media (max-width:520px) {
  .card { padding:32px 20px 28px; border-radius:16px; }
  .act-btn { font-size:.58rem; padding:.55rem 1rem; min-width:120px; }
}
</style>
</head>
<body>

<div class="card" id="card">
  <div class="church-lbl">St. George Coptic Orthodox Church &middot; Brooklyn, NY</div>
  <div class="retreat-lbl">&#10022; Wise for Salvation &middot; Retreat 2026 &#10022;</div>
  <span class="cross-sym">&#9769;</span>

  <div class="date-badge" id="dateBadge">&#128197;&nbsp;<span id="dateText"></span></div>

  <div class="rule"><span>&#10013;</span></div>

  <div class="verse-en"  id="verseEn"></div>
  <div class="verse-ar"  id="verseAr"></div>
  <div class="reference" id="verseRef"></div>

  <div class="rule"><span>&#10013;</span></div>

